# Claves de API — copia este archivo a `.env` y rellena las que vayas a usar.
#
#     cp .env.example .env
#
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# No hace falta poner todas. La aplicación omite los proveedores sin clave y
# sigue con el siguiente de la cadena; si no hay ninguno, usa Ollama en local.
#
# Prioridad: una variable de entorno exportada gana sobre lo que ponga aquí,
# para poder sobrescribir una clave en una ejecución concreta sin editar nada.

# --- Gemini ---------------------------------------------------------------
# https://aistudio.google.com/apikey
# Es el primero de casi todas las cadenas: contexto largo, salida estructurada
# nativa y lectura de imágenes para el OCR de diapositivas.
GEMINI_API_KEY=

# --- DeepSeek -------------------------------------------------------------
# https://platform.deepseek.com/api_keys
# El más barato de los tres. Buen respaldo.
DEEPSEEK_API_KEY=

# --- OpenAI ---------------------------------------------------------------
# https://platform.openai.com/api-keys
# Solo se usa por defecto en las actas de cliente, que son las que enseñas.
OPENAI_API_KEY=

# --------------------------------------------------------------------------
# Qué modelo usa cada proveedor se configura en config/providers.toml, no aquí.
# Los identificadores de modelo cambian a menudo: confirma el vigente en la
# documentación del proveedor.
#
# Ollama en local no necesita clave. Para usarlo:
#     ollama serve && ollama pull qwen3:14b
# --------------------------------------------------------------------------
